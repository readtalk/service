{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "service-server",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/server/app.ts",
  "kv_namespaces": [
    {
      "binding": "AUTH_STORAGE",
      "id": "54f89be27a414fabaf381a919403582e"
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "SERVER_D1",
      "database_id": "9c6d47de-7136-494a-96aa-3e16648a4880"
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
